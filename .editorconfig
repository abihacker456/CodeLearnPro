# EditorConfig — https://editorconfig.org
# Tells editors how to format files in this project.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL

[*.{xml,html,yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{gradle,properties}]
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

[*.sh]
end_of_line = lf